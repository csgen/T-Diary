# Copy to .env and fill in. .env is gitignored; this example is committed.
#
# config.toml describes the shape of a configuration. This file is where YOUR
# accounts, paths, and names live -- none of it belongs in version control.

# Earliest date the dashboard shows by default (YYYY-MM-DD).
# A good choice is the first date on which every account you track has data,
# so cross-account comparison is not skewed by one having a longer history.
TD_DASHBOARD_FROM=2026-01-01

# --- Source slots -----------------------------------------------------------
# Fill in as many as you have. Leave the rest entirely unset; unused slots are
# ignored. config.toml ships 4 slots -- add more there if you need them.
#
# ID     short key, used in the database and CLI output (e.g. laptop, desktop)
# LABEL  display name in the dashboard; defaults to ID if blank
# PATH   full path to that install's Claude Code projects directory
# EMAIL  optional; see below
#
# Forward slashes work everywhere, including WSL UNC paths -- backslash UNC
# paths read unreliably from Python on Windows (PLAN.md §2.7).
#
#   Windows : C:/Users/<you>/.claude/projects
#   WSL     : //wsl.localhost/<Distro>/home/<you>/.claude/projects
#   Linux   : /home/<you>/.claude/projects
#   macOS   : /Users/<you>/.claude/projects

TD_S1_ID=main
TD_S1_LABEL=Main
TD_S1_PATH=/home/you/.claude/projects
# Optional. Only used to warn when the account signed in on a machine is not
# the one you expect. Identity itself is always read from that install's
# .claude.json at scan time, never from here -- leaving it blank is fine.
TD_S1_EMAIL=

# Second account, if you have one. Delete or leave unset if not.
TD_S2_ID=
TD_S2_LABEL=
TD_S2_PATH=
TD_S2_EMAIL=
